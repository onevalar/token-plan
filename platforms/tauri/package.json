{
  "name": "tokenplan-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/sync-localizations.mjs && tsc --noEmit && vite build",
    "test": "vitest run src && node --test scripts/*.test.mjs",
    "test:ui": "playwright test",
    "test:mac-preview": "playwright test --config playwright.preview.config.ts",
    "preview:mac": "node scripts/build-macos-preview.mjs",
    "tauri": "tauri",
    "prepare:bridge": "node scripts/prepare-bridge.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5",
    "@fontsource/inter": "^5",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^5.0.5"
  }
}
