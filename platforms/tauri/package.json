{
  "name": "tokenplan-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/sync-localizations.mjs && npm run check && vite build",
    "check": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run src && node --test scripts/*.test.mjs",
    "test:ui": "playwright test",
    "test:release-ui": "playwright test --config playwright.release.config.ts",
    "test:mac-preview": "playwright test --config playwright.preview.config.ts",
    "preview:mac": "node scripts/build-macos-preview.mjs",
    "compare:svelte": "node scripts/compare-svelte.mjs",
    "sync:valar": "node scripts/sync-valar.mjs",
    "tauri": "tauri",
    "prepare:bridge": "node scripts/prepare-bridge.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5",
    "@fontsource/inter": "^5",
    "@lucide/svelte": "^1.27.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@valar/svelte-primitives": "file:vendor/valar-svelte-primitives.tgz",
    "@valar/svelte-ui": "file:vendor/valar-svelte-ui.tgz",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "svelte-check": "^4.7.4",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
